# ── Flask ────────────────────────────────────────────────
FLASK_ENV=development
# Also signs this API's own session JWTs (no Supabase Auth / no password).
FLASK_SECRET_KEY=replace-with-a-long-random-string

# ── Supabase Postgres (SQLAlchemy) ───────────────────────
# Settings → Database → Connection string → URI (use the 6543 pooler)
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Supabase project API (reserved for future use, e.g. Storage) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_KEY=<service-role-key>          # keep server-side only

# ── Authentica (OTP provider for US-36) ──────────────────
AUTHENTICA_BASE_URL=https://api.authentica.sa
AUTHENTICA_API_KEY=....our authintica key
AUTHENTICA_OTP_METHOD=whatsapp
AUTHENTICA_TEMPLATE_ID=20..etc
AUTHENTICA_FALLBACK_EMAIL=zaytona.team@gmail.com

# ── Firebase Cloud Messaging (push notifications) ────────
# Firebase console -> Project settings -> Service accounts -> Generate
# new private key. Paste the whole downloaded JSON as ONE line, single-quoted.
FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ── Celery (background jobs — 12h list-reminder sweep) ───
# Run `redis-server` locally, or point at a hosted Redis for staging/prod.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
